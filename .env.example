# Database
# For local SQLite: DATABASE_URL=sqlite:///expenses.db
# For Supabase PostgreSQL: DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.eapwnbuecsymtkidzoad.supabase.co:5432/postgres
DATABASE_URL=postgresql://postgres:[YOUR-DATABASE-PASSWORD]@db.eapwnbuecsymtkidzoad.supabase.co:5432/postgres

# Gmail SMTP (create App Password at: https://myaccount.google.com/apppasswords)
# Enable 2FA first, then generate an App Password for "Mail"
GMAIL_SMTP_HOST=smtp.gmail.com
GMAIL_SMTP_PORT=587
GMAIL_EMAIL=your-email@gmail.com
GMAIL_APP_PASSWORD=your-16-char-app-password
REPORT_RECIPIENT=partner-email@gmail.com

# App Settings
APP_TITLE=Our Expense Tracker
DEFAULT_CURRENCY=₹
DATE_FORMAT=DD/MM/YYYY
TIMEZONE=Asia/Kolkata